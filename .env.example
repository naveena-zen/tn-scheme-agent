# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection (pgvector enabled)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tn_scheme_assistant
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=tn_scheme_assistant
PGPORT=5432

# Google Gemini API Key (Required for RAG Embeddings & Agentic Orchestration)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication Secrets
JWT_SECRET=tn_scheme_assistant_jwt_secret_key_2026_super_secure
JWT_REFRESH_SECRET=tn_scheme_assistant_refresh_token_secret_key_2026

# Firebase Cloud Messaging (Web Push)
FIREBASE_SERVICE_ACCOUNT=your_firebase_service_account_json_base64_or_path
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# Google Cloud Speech-to-Text & Text-to-Speech Credentials (Optional - fallback provided)
GOOGLE_APPLICATION_CREDENTIALS=your_google_cloud_credentials_json_path
