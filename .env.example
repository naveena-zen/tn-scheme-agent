# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection (pgvector enabled)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tn_scheme_assistant
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=tn_scheme_assistant
PGPORT=5432

# Google Gemini API Key (Required for RAG Embeddings, Agentic Orchestration, Scam Check Citizen Explanations & Screenshot Vision OCR)
GEMINI_API_KEY=your_gemini_api_key_here

# Scam Detector Configuration (Feature 3: Public Scam & Fraud Check)
# Maximum characters allowed per check (default: 5000)
SCAM_CHECK_MAX_CHARS=5000

# JWT Authentication Secrets
JWT_SECRET=tn_scheme_assistant_jwt_secret_key_2026_super_secure
JWT_REFRESH_SECRET=tn_scheme_assistant_refresh_token_secret_key_2026

# Firebase Cloud Messaging (Web Push)
FIREBASE_SERVICE_ACCOUNT=your_firebase_service_account_json_base64_or_path
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# Google Cloud Speech-to-Text & Text-to-Speech Credentials (Optional - fallback provided)
GOOGLE_APPLICATION_CREDENTIALS=your_google_cloud_credentials_json_path

# Map & Places Provider Configuration (Feature 1: Nearby Government Offices)
# Free tier OpenStreetMap + Overpass API default (zero configuration required)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# Optional alternative map providers:
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Frontend Environment Variables
VITE_API_URL=http://localhost:5000
